body {
    font-family: 'Lato', sans-serif; /* Clean, formal sans-serif font */
    background-color: #f0f2f5; /* Light gray background */
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    padding: 20px;
    box-sizing: border-box; /* Include padding in element's total width and height */
}

.form-container {
    background-color: #ffffff; /* White card background */
    padding: 30px 40px; /* Adjusted padding */
    border-radius: 8px; /* Slightly rounded corners */
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1); /* Subtle shadow */
    width: 100%;
    max-width: 800px; /* Wider container for horizontal layout */
    text-align: left; /* Align text to left within container */
}

h1 {
    font-size: 26px;
    color: #333333; /* Dark gray for heading */
    margin-bottom: 30px;
    text-align: center; /* Center the title */
    font-weight: 700; /* Bold heading */
}

.form-row {
    display: flex;
    flex-wrap: wrap; /* Allow items to wrap on smaller screens */
    gap: 20px; /* Space between form groups */
    margin-bottom: 20px;
    align-items: flex-end; /* Align inputs to the bottom */
}

.form-group {
    flex: 1; /* Allow form groups to grow and shrink */
    min-width: 200px; /* Minimum width for each group before wrapping */
}

label {
    display: block;
    font-size: 14px;
    color: #555555; /* Medium gray for labels */
    margin-bottom: 6px;
    font-weight: 700; /* Bold labels */
}

input[type="text"],
select,
textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid #cccccc; /* Light gray border */
    border-radius: 4px; /* Slightly rounded input fields */
    font-size: 16px;
    color: #333333;
    background-color: #fcfcfc; /* Very light background for inputs */
    box-sizing: border-box; /* Include padding and border in width */
    transition: border-color 0.2s ease, box-shadow 0.2s ease; /* Smooth transitions */
}

input[type="text"]:focus,
select:focus,
textarea:focus {
    border-color: #007bff; /* Blue border on focus */
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25); /* Subtle blue shadow on focus */
    outline: none; /* Remove default outline */
}

select {
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%23666%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%00-13-5.4H18.4c-6.5%200-12.3%203.2-16.1%208.1-3.8%204.9-3.9%2011.6-.1%2016.5l136.8%20138.8c4%204.1%209.7%206.3%2015.7%206.3s11.7-2.2%2015.7-6.3L287%2085.9c3.9-4.9%203.9-11.6.1-16.5z%22%2F%3E%3C%2Fsvg%3E'); /* Custom dark gray arrow */
    background-repeat: no-repeat;
    background-position: right 12px center;
    background-size: 10px;
    padding-right: 30px; /* Space for the custom arrow */
}

textarea {
    resize: vertical; /* Only allow vertical resizing */
    min-height: 80px; /* Minimum height for description */
}

.full-width {
    flex: 0 0 100%; /* Ensure description takes full width */
    margin-bottom: 25px; /* More space below description */
}

.submit-button {
    display: block; /* Make button take full width if needed, or center */
    width: auto; /* Allow button to size naturally */
    min-width: 180px; /* Ensure a decent width */
    margin: 0 auto; /* Center the button */
    padding: 12px 25px;
    background-color: #007bff; /* Primary blue button */
    color: #ffffff;
    border: none;
    border-radius: 5px;
    font-size: 17px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 5px rgba(0, 123, 255, 0.3); /* Subtle button shadow */
}

.submit-button:hover {
    background-color: #0056b3; /* Darker blue on hover */
    box-shadow: 0 4px 8px rgba(0, 123, 255, 0.4); /* Enhanced shadow on hover */
}
